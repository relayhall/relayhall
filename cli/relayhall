    finish_resource_call(status, text, getattr(args, "json", False), render)

def cmd_audit_export(args):
    """Export every matching event as newline-delimited JSON without mutating the ledger."""
    output = args.output
    if output != "-" and os.path.exists(output) and not args.force:
        print(f"Refusing to overwrite existing file: {output} (use --force)", file=sys.stderr)
        sys.exit(1)
    target = None
    temp_path = None
    count = 0
    try:
        if output == "-":
            target = sys.stdout
        else:
            directory = os.path.dirname(os.path.abspath(output)) or "."
            fd, temp_path = tempfile.mkstemp(prefix=".relayhall-audit-", suffix=".ndjson", dir=directory, text=True)
            target = os.fdopen(fd, "w", encoding="utf-8")
        before = None
        while True:
            status, text = resource_api("GET", _audit_query(args, before))
            if status != 200:
                if target is not sys.stdout:
                    target.close()
                finish_resource_call(status, text, True, lambda _envelope: None)
            envelope = json.loads(text)
            for event in envelope.get("events", []):
                target.write(json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n")
                count += 1
            before = envelope.get("nextCursor")
            if not before:
                break
        if target is not sys.stdout:
            target.flush()
            os.fsync(target.fileno())
            target.close()
            os.replace(temp_path, output)
            temp_path = None
            print(f"Exported {count} audit events to {output}")
    finally:
        if target is not None and target is not sys.stdout and not target.closed:
            target.close()
        if temp_path and os.path.exists(temp_path):
            os.unlink(temp_path)

