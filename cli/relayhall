#
# Design 96f0bd3d s7.2. The stored row is a POINTER and the answer is DERIVED
# at read: it resolves only while the Group is featured, the Account is a member
# of it, and the Account is active. `show` therefore prints THREE things - the
# resolved value, the pointer that survives an unresolving state, and which
# clause refused - because "no home group" and "a home group that stopped
# resolving this morning" are different situations and only one of them is a
# thing the person should re-choose.


HOME_GROUP_UNRESOLVED = {
    "no_home_group": "you have not chosen one (or the group it named is gone)",
    "not_featured": "the group is no longer featured",
    "not_a_member": "you are no longer a member of it",
    "actor_inactive": "your account is not active",
}


def _render_home_group(envelope):
    home = envelope.get("homeGroup") or {}
    pointer = home.get("pointer")
    if home.get("groupId"):
        name = home.get("groupName") or home["groupId"]
        print(f"\U0001F3E0 Home group: {name}  ({home['groupId']})")
        if pointer:
            print(f"   set by:  {pointer.get('source')}")
        return
    if not pointer:
        print("\U0001F3E0 No home group. Choose one with: relayhall home-group set <group-id>")
        return
    reason = home.get("unresolvedReason") or "no_home_group"
    print(f"\U0001F3E0 Home group: not resolving  (pointer {pointer.get('groupId')},"
          f" set by {pointer.get('source')})")
    print(f"   why: {HOME_GROUP_UNRESOLVED.get(reason, reason)}")
    print("   The pointer is kept. Restore the condition above and it resolves again,"
          " with no re-write.")


