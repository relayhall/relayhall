#!/usr/bin/env python3
"""relayhall - CLI for RelayHall task management.

Usage:
  relayhall list [--status STATUS] [--project PROJECT] [--priority PRIORITY] [-v]
  relayhall next
  relayhall current
  relayhall get ID
  relayhall create TITLE [options]
  relayhall update ID [options]
  relayhall move ID STATUS [--notes NOTES]
  relayhall archive ID [--reason TEXT]           # Any status; non-completed archives as abandoned (warns)
  relayhall delete ID
  relayhall session-status ID [--live]           # Show ACP session status
  relayhall brief ID                             # Compile + print the Task Brief (no execution)
  relayhall breakdown ID
  relayhall auto-archive
  relayhall doctor [--json] [--discord-summary] [--deliver stdout|hermes-discord] [--deliver-target TARGET] [--post-discord] [--discord-webhook URL] [--install-cron] [--dry-run]

  # Subtask management (6-state: empty → in-progress → review → completed)
  relayhall start-subtask TASK_ID INDEX          # Agent: marks in-progress
  relayhall complete-subtask TASK_ID INDEX       # Agent: marks review (ready for approval)
  relayhall approve-subtask TASK_ID INDEX        # Independent Verifier: marks completed
  relayhall reject-subtask TASK_ID INDEX --note  # Verifier: back to Not started
  relayhall stuck-subtask TASK_ID INDEX --reason # Agent/Verifier: marks Stuck
  relayhall skip-subtask TASK_ID INDEX           # Orchestrator: marks skipped (counts as done)
  relayhall uncomplete-subtask TASK_ID INDEX     # Legacy: marks as empty

  # Task dependencies
  relayhall add-dep TASK_ID DEPENDS_ON_ID        # Add dependency (task depends on another)
  relayhall remove-dep TASK_ID DEPENDS_ON_ID     # Remove dependency
  relayhall deps TASK_ID                         # Show dependencies for a task

  # Project management
  relayhall projects [--include-stats]
  relayhall project get ID
  relayhall project create --name NAME [--description DESC] [--status STATUS]
  relayhall project update|edit ID --revision REV [--name] [--description] [--status]
  relayhall project archive ID --revision REV
  relayhall project unarchive ID --revision REV
  relayhall project stats ID [--days DAYS]
  relayhall project context PROJECT [--json]
  relayhall project compatibility-status PROJECT [--json]

  # Project Resources (canonical typed records: repository/environment/workspace/reference)
  relayhall project resource list PROJECT [--kind KIND] [--include-archived] [--json]
  relayhall project resource get PROJECT RESOURCE [--json]
  relayhall project resource add-repository PROJECT --name N --url URL [--role primary|additional] [--default-branch B]
  relayhall project resource add-environment PROJECT --name N --url URL --stage STAGE
  relayhall project resource add-workspace PROJECT --name N --path PATH --purpose PURPOSE
  relayhall project resource add-reference PROJECT --name N --url URL --category CATEGORY
  relayhall project resource edit PROJECT RESOURCE --revision REV [--name] [--description] [--agent-visibility] [--export-policy] [kind fields]
  relayhall project resource archive PROJECT RESOURCE --revision REV
  relayhall project resource restore PROJECT RESOURCE --revision REV
  relayhall project resource replace PROJECT RESOURCE --revision REV --idempotency-key KEY --kind K --name N [kind fields]

  # Retired writers (fail closed and name the canonical replacement):
  #   project delete / project create --init|--nfs
  #   project set-repo / set-env / set-paths / add-notebook / add-link / update-link / delete-link

  # Skill management (bare plural `relayhall skills` = skill list)
  relayhall skills
  relayhall skill list [--category CAT] [--tag TAG] [--search QUERY] [--project PROJECT] [-v]
  relayhall skill get SKILL [--version VERSION] [--full]
  relayhall skill search QUERY
  relayhall skill create --name NAME [--category CAT] [--description DESC] [--usage TEXT] [--usage-file FILE] [--tags TAGS]
  relayhall skill update SKILL [--category] [--description] [--usage] [--tags]
  relayhall skill audience SKILL {global,project}
  relayhall skill pin SKILL PROJECT VERSION
  relayhall skill unpin SKILL PROJECT
  relayhall skill delete SKILL [--confirm]
  relayhall skill context PROJECT

  # Charter management (the project's authority index; writes are owner-plane)
  relayhall charter get PROJECT [--content-only] [--json]
  relayhall charter set PROJECT --file FILE [--revision REV] [--json]
  relayhall charter set PROJECT --content TEXT [--revision REV] [--json]
  relayhall charter versions PROJECT [--json]
  relayhall charter show-version PROJECT VERSION [--json]

  # Phase sequence creation
  relayhall create-multiphase "TITLE" --project PROJECT --tag TAG --phases "Build;Verify;..."

  relayhall --help

Examples:
  # Task creation (auto-pickup defaults to OFF; opt in with --auto-start true)
  relayhall create "Fix login bug" --project my-project --priority high --subtasks "Check auth;Fix token;Test"
  relayhall create "Ship the beta" --project my-project --notes "Cut from the Friday build"
  relayhall create "Ship the beta" --due 2026-09-07T17:00:00Z
  relayhall create "Research topic" --project my-project --status ideas --tags "research,agent-task"
  relayhall create "Nightly maintenance" --project ops --status todo --auto-start true   # orchestrator may auto-pick this

  # Task management
  relayhall list --status todo
  relayhall move abc123 in-progress --notes "Starting work"
  relayhall update abc123 --priority urgent --add-subtask "New subtask"

  # Subtask workflow (six states: empty, in-progress, review, completed, stuck, skipped)
  relayhall complete-subtask abc123 0       # Agent marks as review
  relayhall approve-subtask abc123 0        # Independent Verifier approves review → completed
  relayhall reject-subtask abc123 0 --note "Needs more testing"  # Verifier returns it to Not started
  relayhall stuck-subtask abc123 0 --reason "Needs owner input"
  relayhall skip-subtask abc123 0           # Orchestrator records an intentional omission

  relayhall session-status abc123              # Show session state

  # Project creation (registry record only; directories are workspace resources)
  relayhall project create --name "my-project" --description "My new project"

  # Project Resources
  relayhall project resource add-repository my-proj --name main --url "https://github.com/example/my-project" --role primary
  relayhall project resource add-environment my-proj --name prod --url "https://example.com/dashboard/" --stage production
  relayhall project resource add-workspace my-proj --name workbench --path "/data/projects/my-project" --purpose source
  relayhall project resource add-reference my-proj --name docs --url "https://docs.example/my-project" --category documentation
  relayhall project context my-proj

  # Phase sequence
  relayhall create-multiphase "Website Redesign" --project my-site --tag "site-redesign" --phases "Design;Frontend;Backend;Testing"

Complete Workflows:

  relayhall next                                  # Get next task
  # --- OR manual two-step: ---
  relayhall move abc123 in-progress               # Start it manually
  relayhall get abc123 -v                         # Check progress
  relayhall move abc123 review                     # Implementer hands off for independent review
  # Independent Verifier then approves/rejects reviewed subtasks and resolves the task.

  # Agent: Work a task
  relayhall get abc123 -v                         # Read task
  # ... do work on subtask 0 ...
  relayhall complete-subtask abc123 0             # Mark review
  # ... do work on subtask 1 ...
  relayhall complete-subtask abc123 1             # Mark review
  relayhall move abc123 review --notes "Ready for independent review"

  # Setup new project
  relayhall project create --name "my-proj"
  relayhall project resource add-repository my-proj --name main --url "git@..." --role primary
  relayhall project resource add-environment my-proj --name prod --url "https://..." --stage production
  relayhall project resource add-workspace my-proj --name shared --path "/data/projects/my-proj" --purpose data
"""

