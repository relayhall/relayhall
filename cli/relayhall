    })
    
    task = result.get("task", {})
    subtasks = task.get("subtasks") or []
    
    if index < len(subtasks):
        print(f"🟡 Marked subtask [{index}] as review: {subtasks[index].get('text', '')}")
    else:
        print(f"🟡 Marked subtask [{index}] as review")
    
    summary = result.get("subtaskSummary", {})
    print(f"   Summary: {summary.get('completed', 0)} ✅ | {summary.get('review', 0)} 🟡 | {summary.get('in_progress', 0)} 🔄 | {summary.get('empty', 0)} ⬜")
    if summary.get('stuck', 0) > 0:
        print(f"   ⚠️ {summary.get('stuck', 0)} subtask(s) stuck!")
    print(format_task(task, verbose=True))

