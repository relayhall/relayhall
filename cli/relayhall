def cmd_agent_mint(args):
    """The canonical session mint (design 4d961e37 §6.1a/§9.2): the human is
    requester AND approver, so the act is one interactive step-up-gated call.
    The CLI prompts for the password, mints the single-use elevation token
    bound to (agent.mint, task), and performs the atomic mint. The returned
    pack renders EXACTLY ONCE and is never stored server-side — capture the
    secret now. Bearer credentials cannot step up (AZ-18): run `relayhall
    login` first; a Connector requests through the API/MCP mint surface
    instead."""
    import getpass
    task_id = args.task
    if not UUID_PATTERN_CLI.match(task_id):
        print("❌ --task must be a full task UUID", file=sys.stderr)
        sys.exit(1)
    scopes = args.scope or []
    if not scopes:
        print("❌ At least one --scope is required (e.g. --scope tasks:read --scope tasks:write)", file=sys.stderr)
        sys.exit(1)
    rules = None
    if getattr(args, "rules", None):
        try:
            rules = json.loads(args.rules)
        except json.JSONDecodeError as exc:
            print(f"❌ --rules must be a JSON array of rules: {exc}", file=sys.stderr)
            sys.exit(1)
    password = getattr(args, "password", None) or os.environ.get("RELAYHALL_PASSWORD") or getpass.getpass("Password (step-up, §7.6): ")
    step = api("POST", "/auth/step-up", {"password": password, "action": "agent.mint", "targetId": task_id}, exit_on_error=False)
    if not step.get("stepUpToken"):
        print(f"❌ Step-up refused: {step.get('error') or step}", file=sys.stderr)
        print("   The session mint is a LOGIN-SESSION act (AZ-18): run `relayhall login` first; bearer credentials never step up.", file=sys.stderr)
        sys.exit(1)
    body = {"targetTaskId": task_id, "requestedScopes": scopes, "stepUpToken": step["stepUpToken"]}
    if rules is not None:
        body["requestedRules"] = rules
    if getattr(args, "label", None):
        body["label"] = args.label
    result = api("POST", "/delegation/agent-mints", body, exit_on_error=False)
    if not result.get("success"):
        print(f"❌ Mint refused: {result.get('error') or result}", file=sys.stderr)
        sys.exit(1)
    if getattr(args, "json", False):
        print(json.dumps(result, indent=2))
        return
    pack = result.get("pack", {})
    onboarding = pack.get("onboarding", {})
    print(f"✅ Agent minted: {pack.get('handle')} ({str(pack.get('principalId'))[:8]}) bound to task {task_id[:8]}")
    print(f"   Scopes: {', '.join(pack.get('scopes', []))}  ·  expires {pack.get('expiresAt')}")
    print("   ── ONE-TIME PACK (never stored server-side — capture it now) ──")
    print(f"   {onboarding.get('bootstrapLine', '')}")
    for line in onboarding.get("cliEnv", []):
        print(f"   {line}")
    print("   MCP config (generic stdio):")
    print("   " + json.dumps(onboarding.get("mcpConfig", {}).get("generic", {}), separators=(",", ":")))
    brief = onboarding.get("brief")
    if brief:
        out_path = getattr(args, "brief_out", None)
        if out_path:
            with open(out_path, "w", encoding="utf-8") as handle:
                handle.write(brief)
            print(f"   Compiled Brief written to {out_path}")
        else:
            print("   ── COMPILED BRIEF ──")
            print(brief)

def _audit_query(args, before=None):
    params = {"limit": str(getattr(args, "limit", 100))}
    for attr, key in (
        ("action", "action"), ("actor", "actorPrincipalId"),
        ("resource_type", "resourceType"), ("resource_id", "resourceId"),
    ):
        value = getattr(args, attr, None)
        if value:
            params[key] = value
    if before:
        params["before"] = before
    return "/audit?" + urllib.parse.urlencode(params)

def cmd_audit_list(args):
    """Read one page from the append-only audit ledger."""
    status, text = resource_api("GET", _audit_query(args, getattr(args, "before", None)))
    def render(envelope):
        events = envelope.get("events", [])
        print(f"Audit events ({len(events)}) — retention indefinite; purge unavailable")
        for event in events:
            actor = event.get("actorHandle") or "unknown"
            resource = f"{event.get('resourceType')}:{event.get('resourceId') or '-'}"
            print(f"   {event.get('occurredAt')}  {event.get('action')}  {actor}  {resource}")
        if envelope.get("nextCursor"):
