def _add_resource_common_flags(parser, export_policy=True):
    """Shared flags for Project Resource add/edit/replace parsers.

    Workspace parsers omit --export-policy on purpose: a workspace is always
    installation-only, so the flag is rejected as a usage error there."""
    parser.add_argument("--description", help="Optional description (max 1000 chars)")
    parser.add_argument("--agent-visibility", dest="agent_visibility", choices=VALID_RESOURCE_VISIBILITY,
                        help="Whether agent-facing surfaces may see this resource (default hidden)")
    if export_policy:
        parser.add_argument("--export-policy", dest="export_policy", choices=VALID_RESOURCE_EXPORT_POLICIES,
                            help="Whether the value may leave this installation (default installation-only)")

PRIORITIES = ("urgent", "high", "normal", "low", "someday")


def main():
    parser = argparse.ArgumentParser(
        prog=os.path.basename(sys.argv[0]),
        description="RelayHall — task, project, and skill management CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Subtask Workflow (6-state lifecycle):
  ⬜ empty → 🔄 in-progress → 🟡 review → ✅ completed (independent Verifier only)
                                      ↘ 🔴 stuck
                                      ↘ ⏭️ skipped

  Agent workflow:
    1. relayhall start-subtask TASK_ID INDEX     (marks in-progress)
    2. Work on subtask...
    3. relayhall complete-subtask TASK_ID INDEX  (marks review)
    4. When all done: relayhall move TASK_ID review --notes "Ready for independent review"

  Independent Verifier workflow:
    1. relayhall review TASK_ID                  (see all subtasks)
    2. For each subtask in review:
       relayhall approve-subtask TASK_ID INDEX   (marks completed)
       relayhall reject-subtask TASK_ID INDEX    (back to empty)
       relayhall stuck-subtask TASK_ID INDEX     (marks stuck / human gate)
       relayhall skip-subtask TASK_ID INDEX      (marks skipped, counts as done)
    3. Accepted review completes the task only when every subtask is completed or skipped
"""
    )
    # Global flags
    parser.add_argument("--api", help="API base URL (overrides RELAYHALL_API_URL)")
    parser.add_argument("--token", help="Auth token (overrides RELAYHALL_TOKEN)")
    parser.add_argument("--yes", "-y", action="store_true", help="Auto-confirm all interactive prompts")
    
    sub = parser.add_subparsers(dest="command")
    try:
        from relayhall_blueprints import register as register_blueprints, run as run_blueprint
    except ModuleNotFoundError as error:
        if error.name != 'relayhall_blueprints': raise
        sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
        from relayhall_blueprints import register as register_blueprints, run as run_blueprint
    register_blueprints(sub)
    
    # login
    p_login = sub.add_parser("login", help="Login and cache auth token")
    p_login.add_argument("--password", help="Password (or use RELAYHALL_PASSWORD env, or interactive prompt)")
    
    # list
    p_list = sub.add_parser("list", aliases=["ls"], help="List tasks")
    p_list.add_argument("--status", "-s")
    p_list.add_argument("--project", "-p")
    p_list.add_argument("--phase", help="Filter by Phase UUID, or 'null' for the unphased backlog")
    p_list.add_argument("--priority", choices=PRIORITIES)
    p_list.add_argument("--verbose", "-v", action="store_true")
    
    # next
    sub.add_parser("next", help="Get next auto-start task")
    
    # current
    sub.add_parser("current", help="Get current in-progress task")
    
    # get
    p_get = sub.add_parser("get", help="Get task details")
    p_get.add_argument("id")
    
    # create
    p_create = sub.add_parser("create", aliases=["new"], help="Create a task")
    p_create.add_argument("title")
    p_create.add_argument("--description", "-d")
    p_create.add_argument("--status", "-s", default="ideas")
    p_create.add_argument("--priority", default="normal", choices=PRIORITIES)
    p_create.add_argument("--project", "-p")
    p_create.add_argument("--phase", help="Phase UUID to group this task under (optional; unphased is the project backlog)")
    p_create.add_argument("--subtasks", help="Semicolon-separated subtask list")
    p_create.add_argument("--tags", help="Comma-separated tags")
    p_create.add_argument("--notes", help="Task notes (the same field 'update --notes' writes)")
    p_create.add_argument("--due", help="When this Task is due, as an ISO-8601 instant (2026-09-07T17:00:00Z). A past instant is accepted.")
    p_create.add_argument("--blocked-by", help="Comma-separated blocker IDs")
    p_create.add_argument("--depends-on", help="Comma-separated task IDs this task depends on")
    # Lifecycle gate: auto-start is opt-in. Default FALSE so newly created
    # tasks are never silently eligible for orchestrator auto-pickup.
    # (Old form `type=bool, default=None` treated ANY string — even "false" —
    # as truthy and left the default up to the backend.)
    p_create.add_argument("--auto-start", choices=["true", "false"], default="false",
                          help="Allow orchestrator auto-pickup from todo (default: false; opt in with --auto-start true)")
    p_create.add_argument("--model", "-m", help="OpenClaw model id or alias (for example openai-codex/gpt-5.5)")
    p_create.add_argument("--thinking", choices=VALID_THINKING_LEVELS, help="AI reasoning depth (low/medium/high)")
    p_create.add_argument("--service", help="Target Connector (registered Service slug or UUID) — requires services:invoke")
