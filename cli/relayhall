def run_tests():
    """Run workflow guardrail tests."""
    print("🧪 Running relayhall workflow guardrail tests...\n")
    
    passed = 0
    failed = 0
    
    # Test 1: is_agent_context detection
    print("Test 1: Agent context detection")
    original_env = os.environ.get("RELAYHALL_AGENT")
    os.environ["RELAYHALL_AGENT"] = "1"
    if is_agent_context():
        print("  ✅ PASS: Detected agent context via env var")
        passed += 1
    else:
        print("  ❌ FAIL: Failed to detect agent context via env var")
        failed += 1
    if original_env:
        os.environ["RELAYHALL_AGENT"] = original_env
    else:
        del os.environ["RELAYHALL_AGENT"]
    
    # Test 2: Review status validation
    print("\nTest 2: Review status validation")
    try:
        result = validate_status("review")
        if result == "review":
            print("  ✅ PASS: Review status is valid")
            passed += 1
        else:
            print(f"  ❌ FAIL: Expected 'review', got '{result}'")
            failed += 1
    except SystemExit:
        print("  ❌ FAIL: Review status rejected as invalid")
        failed += 1
    
    # Test 3: format_subtask_status for all states
    print("\nTest 3: Subtask status formatting")
    test_cases = [
        ({"status": "empty"}, "⬜"),
        ({"status": "review"}, "🔄"),
        ({"status": "completed"}, "✅"),
    ]
    for subtask, expected_icon in test_cases:
        icon = format_subtask_status(subtask)
        if icon == expected_icon:
            print(f"  ✅ PASS: {subtask['status']} → {icon}")
            passed += 1
        else:
            print(f"  ❌ FAIL: {subtask['status']} → expected {expected_icon}, got {icon}")
            failed += 1
    
    # Test 4: Status icons include review
    print("\nTest 4: Task status icons")
    task = {"status": "review", "title": "Test", "id": "test123", "subtasks": []}
    formatted = format_task(task)
    if "🔍" in formatted:
        print("  ✅ PASS: Review status shows 🔍 icon")
        passed += 1
    else:
        print(f"  ❌ FAIL: Review icon not found in: {formatted}")
        failed += 1
    
    print(f"\n{'='*50}")
    print(f"Tests: {passed + failed} | Passed: {passed} | Failed: {failed}")
    if failed == 0:
        print("✅ All tests passed!")
    else:
        print(f"❌ {failed} test(s) failed")
    print(f"{'='*50}\n")
    
    sys.exit(0 if failed == 0 else 1)

if __name__ == "__main__":
    # Check if --test flag is passed
    if "--test" in sys.argv:
        run_tests()
    else:
        main()
