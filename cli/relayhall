def _read_file_as_attachment(file_path):
    """Read a file and return an attachment dict {name, content, encoding, mimeType}.
    
    Text files are read as utf8; binary files are base64-encoded.
    Returns None if the file cannot be read.
    """
    import base64
    TEXT_EXTS = {'.md', '.txt', '.ts', '.tsx', '.js', '.py', '.sh', '.json',
                 '.yaml', '.yml', '.toml', '.env', '.sql', '.html', '.css', '.cursorrules'}
    MIME_MAP = {
        '.md': 'text/markdown', '.txt': 'text/plain', '.ts': 'text/typescript',
        '.tsx': 'text/typescript', '.js': 'text/javascript', '.py': 'text/x-python',
        '.sh': 'text/x-shellscript', '.json': 'application/json',
        '.yaml': 'text/yaml', '.yml': 'text/yaml', '.toml': 'text/toml',
        '.env': 'text/plain', '.sql': 'text/x-sql', '.html': 'text/html',
        '.css': 'text/css',
    }
    path = os.path.abspath(os.path.expanduser(file_path))
    if not os.path.isfile(path):
        print(f"⚠️  --attach: file not found: {path}", file=sys.stderr)
        return None
    size = os.path.getsize(path)
    if size > 100 * 1024:
        print(f"⚠️  --attach: skipping {path} (too large: {size // 1024} KB > 100 KB limit)", file=sys.stderr)
        return None
    ext = os.path.splitext(path)[1].lower()
    name = os.path.basename(path)
    try:
        if ext in TEXT_EXTS:
            content = open(path, 'r', encoding='utf-8', errors='replace').read()
            return {'name': name, 'content': content, 'encoding': 'utf8', 'mimeType': MIME_MAP.get(ext, 'text/plain')}
        else:
            content = base64.b64encode(open(path, 'rb').read()).decode('ascii')
            return {'name': name, 'content': content, 'encoding': 'base64', 'mimeType': 'application/octet-stream'}
    except Exception as e:
        print(f"⚠️  --attach: could not read {path}: {e}", file=sys.stderr)
        return None

