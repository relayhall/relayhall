def cmd_skill_search(args):
    """Search skills by name, description, tags, or instructions."""
    query = args.query.lower()

    # Try server-side search first
    try:
        qs = urllib.parse.urlencode({"search": args.query})
        result = api("GET", f"/skills?{qs}")
        skills = result.get("skills", [])
    except Exception:
        skills = []

    # Also do client-side filtering for broader matching (instructions, tags)
    all_skills = api("GET", "/skills").get("skills", [])
    matched_ids = {t["id"] for t in skills}

    for t in all_skills:
        if t["id"] in matched_ids:
            continue
        searchable = " ".join([
            t.get("name", ""),
            t.get("description", ""),
            t.get("usage_instructions", ""),
            " ".join(t.get("tags", [])),
            t.get("category", ""),
        ]).lower()
        if query in searchable:
            skills.append(t)

    if not skills:
        print(f"No skills matching \"{args.query}\".")
        return

    print(f"\n🔍 Skills matching \"{args.query}\" ({len(skills)})\n")
    for t in skills:
        print(format_skill(t, verbose=True))
    print()

