def cmd_project_resource_replace(args):
    if args.kind == "workspace" and getattr(args, "export_policy", None) == "portable":
        resource_usage_error("workspace resources are always installation-only; drop --export-policy portable")
    key = args.idempotency_key
    if not key:
        if sys.stdin.isatty():
            key = uuid.uuid4().hex
            print(f"🔑 Generated idempotency key: {key}", file=sys.stderr)
        else:
            resource_usage_error("--idempotency-key is required when stdin is not a terminal")
    project_id = resolve_resource_project(args.project)
    rid = urllib.parse.quote(args.resource, safe="")
    body = _resource_body_from_args(args, args.kind)
    # Exactly one REST call: replace is atomic on the server, never create+archive.
    status, text = resource_api("POST", f"/projects/{project_id}/resources/{rid}/replace", body,
                                headers={"If-Match": args.revision, "Idempotency-Key": key})
    def render(envelope):
        replacement = envelope.get("replacement", {})
        replaced = envelope.get("replaced", {})
        print(f"✅ Replaced resource {replaced.get('name', '')} [{replaced.get('kind', '?')}] "
              f"with {replacement.get('name', '')} [{replacement.get('kind', '?')}]")
        print(f"   New ID: {replacement.get('id', '')}   Revision: {replacement.get('revision', '')}")
    finish_resource_call(status, text, False, render)

