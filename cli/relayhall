def cmd_status(args):
    """Show API status and health information."""
    
    # `/health` is the ONLY route this command reads, and every number it
    # prints below comes from there. `/status` was asked for as well and no
    # such route is mounted, so the first command a new operator runs to
    # check their install opened with a red 404 — on a board that was
    # working perfectly (card 16073b11). The reads that used it already
    # carried their `/health` fallbacks; the empty mapping keeps those
    # expressions honest without pretending a second source exists.
    try:
        health = api("GET", "/health", exit_on_error=False)
    except Exception:
        # A transport failure — no server, DNS, timeout — never reached an
        # HTTP status at all.
        health = {"status": "error", "message": "Health endpoint unreachable"}
    if health.get("success") is False:
        health = {"status": "error", "message": health.get("error") or "Health endpoint unreachable"}
    status = {}
    
    # Color helpers
    def green(text):
        return f"\033[92m{text}\033[0m"
    
    def red(text):
        return f"\033[91m{text}\033[0m"
    
    def yellow(text):
        return f"\033[93m{text}\033[0m"
    
    # Print health status
    print("\n🏥 System Health\n")
    
    # API status
    api_status = health.get("status", "unknown")
    if api_status == "healthy" or api_status == "ok":
        print(f"  API: {green('✓ Healthy')}")
    else:
        print(f"  API: {red('✗ Unhealthy')} ({api_status})")
    
    # Database health
    db_health = health.get("database", status.get("database", {}))
    if isinstance(db_health, dict):
        db_status = db_health.get("status", "unknown")
    else:
        db_status = "connected" if db_health else "disconnected"
    
    if db_status in ("connected", "healthy", "ok"):
        print(f"  Database: {green('✓ Connected')}")
    else:
        print(f"  Database: {red('✗ Disconnected')} ({db_status})")
    
    # WebSocket status
    ws_status = status.get("websocket", health.get("websocket", {}))
    if isinstance(ws_status, dict):
        ws_active = ws_status.get("active", False)
        ws_connections = ws_status.get("connections", 0)
    else:
        ws_active = ws_status
        ws_connections = 0
    
    if ws_active:
        print(f"  WebSocket: {green('✓ Active')} ({ws_connections} connections)")
    else:
        print(f"  WebSocket: {yellow('⚠ Inactive')}")
    
    # Task counts
    print("\n📊 Task Statistics\n")
    
    task_counts = status.get("taskCounts", status.get("tasks", {}))
    if task_counts:
        total = task_counts.get("total", 0)
        by_status = task_counts.get("byStatus", {})
        
        print(f"  Total: {total}")
        
        if by_status:
            for s in ["ideas", "todo", "in-progress", "stuck", "completed", "archived"]:
                count = by_status.get(s, 0)
                if count > 0:
                    icon = {"ideas": "💡", "todo": "📋", "in-progress": "🔄", 
                            "stuck": "🚧", "completed": "✅", "archived": "📦"}.get(s, "•")
                    print(f"  {icon} {s}: {count}")
    
    # Uptime
    uptime = status.get("uptime", health.get("uptime"))
    if uptime:
        if isinstance(uptime, (int, float)):
            # Convert seconds to human readable
            hours = int(uptime // 3600)
            minutes = int((uptime % 3600) // 60)
            uptime_str = f"{hours}h {minutes}m"
        else:
            uptime_str = str(uptime)
        
        print(f"\n⏱️  Uptime: {uptime_str}\n")

