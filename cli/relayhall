def resolve_skill(name_or_id):
    """Resolve skill name or ID to a skill dict {id, name}. Supports fuzzy matching."""
    skills = api("GET", "/skills").get("skills", [])

    # Try ID match first (full or prefix)
    for t in skills:
        if t["id"] == name_or_id or t["id"].startswith(name_or_id):
            return t

    # Exact name match
    for t in skills:
        if t["name"].lower() == name_or_id.lower():
            return t

    # Fuzzy name match
    best = None
    best_score = 0
    for t in skills:
        score = SequenceMatcher(None, name_or_id.lower(), t["name"].lower()).ratio()
        if name_or_id.lower() in t["name"].lower() or t["name"].lower() in name_or_id.lower():
            score = max(score, 0.9)
        if score > best_score:
            best_score = score
            best = t

    if best and best_score > 0.4:
        if best["name"].lower() != name_or_id.lower() and not best["id"].startswith(name_or_id):
            print(f"🔧 Matched skill: \"{name_or_id}\" → \"{best['name']}\"", file=sys.stderr)
        return best

    print(f"⚠️  No skill found matching \"{name_or_id}\". Available:", file=sys.stderr)
    for t in skills:
        print(f"   - {t['name']} ({t['id'][:8]})", file=sys.stderr)
    sys.exit(1)

def format_skill(t, verbose=False):
    """Format a skill for display."""
    global_icon = "🌐" if t.get("is_global") else "📌"
    category = t.get("category") or "uncategorized"
    tags = f" 🏷️{','.join(t['tags'])}" if t.get("tags") else ""
    version = f" v{t.get('version')}·{t.get('status')}" if t.get("version") else " no-published-version"
    short_id = t["id"][:8]
    
    line = f"  {global_icon} {short_id}  {t['name']}  [{category}]{tags}{version}"
    
    if verbose:
        line += f"\n     ID: {t['id']}"
        if t.get("description"):
            desc = t["description"][:120]
            line += f"\n     {desc}{'...' if len(t.get('description', '')) > 120 else ''}"
        if t.get("usage_instructions"):
            usage = t["usage_instructions"][:200]
            line += f"\n     📋 Usage: {usage}{'...' if len(t.get('usage_instructions', '')) > 200 else ''}"
    
    return line

