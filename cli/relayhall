def cmd_create_multiphase(args):
    """Create real Phases with one sequential, Phase-bound Task each."""
    if not args.title or not args.project or not args.tag or not args.phases:
        print("❌ --project, --tag, and --phases are required", file=sys.stderr)
        sys.exit(1)
    
    project_name = resolve_project(args.project)
    project_id = resolve_project_id(project_name)
    phases = [p.strip() for p in args.phases.split(";") if p.strip()]
    
    if len(phases) < 2:
        print("❌ Phase sequences need at least 2 phases", file=sys.stderr)
        sys.exit(1)
    
    print(f"🔄 Creating Phase sequence: {args.title}")
    print(f"   Project: {project_name}")
    print(f"   Shared task tag: {args.tag}")
    print(f"   Phases: {len(phases)}")

    # Each entry is a first-class Phase. Its one seed Task is bound through
    # phaseId; the previous Task dependency preserves this helper's sequential
    # workflow without recreating a master Task or phase-N tag hierarchy.
    phase_ids = []
    task_ids = []
    for i, phase in enumerate(phases):
        phase_result = api("POST", "/phases", {
            "projectId": project_id,
            "name": phase,
            "position": i,
        })
        phase_record = phase_result.get("phase", {})
        phase_id = phase_record.get("id", "")
        if not phase_id:
            print(f"❌ API returned no Phase id for '{phase}'", file=sys.stderr)
            sys.exit(1)
        phase_ids.append(phase_id)

        task_data = {
            "title": f"{args.title}: {phase}",
            "project": project_name,
            "phaseId": phase_id,
            # The backend's next-task selector deliberately honors autoStart
            # only in the todo queue. Keep later seed Tasks parked in ideas,
            # but make the first one genuinely eligible for automatic pickup.
            "status": "todo" if i == 0 else "ideas",
            "priority": args.priority or "normal",
            "tags": [args.tag],
            "description": f"Seed task for the {phase} Phase in {args.title}.",
            "autoStart": True if i == 0 else False  # Only first phase auto-starts
        }
        
        # Add dependency on previous phase (except for first phase)
        if i > 0:
            task_data["dependsOn"] = [task_ids[i-1]]
        
        task_result = api("POST", "/tasks", task_data)
        task = task_result.get("task", {})
        task_id = task.get("id", "")
        if not task_id:
            print(f"❌ API returned no Task id for Phase '{phase}'", file=sys.stderr)
            sys.exit(1)
        task_ids.append(task_id)
        
        dep_info = f" (depends on Phase {i})" if i > 0 else ""
        print(f"   ✅ Phase {i+1}: {phase_id[:8]} · Task {task_id[:8]}{dep_info}")

    print(f"\n✅ Phase sequence created!")
    print(f"   Phases: {len(phase_ids)}")
    print(f"   Bound tasks: {len(task_ids)}")

def resolve_task_id(short_id):
    """Resolve a short ID prefix to a full task ID."""
    if len(short_id) >= 36:
        return short_id
    # Search all tasks for prefix match
    result = api("GET", "/tasks")
    tasks = result.get("tasks", [])
    matches = [t for t in tasks if t["id"].startswith(short_id)]
    if len(matches) == 1:
        return matches[0]["id"]
    elif len(matches) == 0:
        # Try archived too
        result2 = api("GET", "/tasks?status=archived")
        archived = result2.get("tasks", [])
        matches = [t for t in archived if t["id"].startswith(short_id)]
        if len(matches) == 1:
            return matches[0]["id"]
        print(f"❌ No task found with ID prefix: {short_id}", file=sys.stderr)
        sys.exit(1)
    else:
        print(f"❌ Ambiguous ID prefix \"{short_id}\", matches:", file=sys.stderr)
        for m in matches:
            print(f"   {m['id'][:12]}  {m['title'][:50]}", file=sys.stderr)
        sys.exit(1)

def resolve_task_id_list(values):
    """Resolve repeated and/or comma-separated task-ID arguments, order-preserving.

    Accepts what argparse produces for both `action="append"` options (a list)
    and plain single-value options (a string), so callers stay compatible.
    """
    if not values:
        return []
    if isinstance(values, str):
        values = [values]
    resolved = []
    for value in values:
        for raw in value.split(","):
            short_id = raw.strip()
            if not short_id:
                continue
            full_id = resolve_task_id(short_id)
            if full_id not in resolved:
                resolved.append(full_id)
    return resolved

# ─── Report Commands ───

# The backend resolves GET /reports?q= as an id::text prefix search when q is
# 8+ hex chars (backend/src/utils/reportIds.ts isReportIdQuery); anything else
# falls through to title/content text search, which is useless for id lookup.
REPORT_ID_QUERY_RE = re.compile(r"^[0-9a-f]{8}(-[0-9a-f-]{0,28})?$", re.IGNORECASE)

# Deep-search cap for the offset-paging fallback: 50 pages x 100 reports.
# Comfortably above the current collection size while bounding a runaway loop.
REPORT_SEARCH_MAX_PAGES = 50

def search_report_prefix(short_id):
    """Search beyond the newest page for reports whose id starts with short_id.

    The plain /reports?limit=100 list only covers the newest 100 reports, so
    older reports need a deeper look. Prefer the server-side id-prefix search
    (single request); fall back to paging through /reports with offset for
    short prefixes, or for older backends where q= is only a text search.
    """
    if REPORT_ID_QUERY_RE.match(short_id):
        result = api("GET", f"/reports?q={urllib.parse.quote(short_id)}&limit=100&include_archived=true")
        matches = [r for r in result.get("reports", []) if r["id"].startswith(short_id)]
        if matches:
            return matches
    # Offset-paging fallback (page 0 was already checked by the caller).
    matches = []
    for page in range(1, REPORT_SEARCH_MAX_PAGES):
        result = api("GET", f"/reports?limit=100&offset={page * 100}&include_archived=true")
        reports = result.get("reports", [])
        matches.extend(r for r in reports if r["id"].startswith(short_id))
        if not reports or not result.get("hasMore"):
            break
    return matches

def resolve_report_id(short_id):
    """Resolve a short ID prefix to a full report ID."""
    if len(short_id) >= 36:
        return short_id
    # include_archived: ID resolution is a read/link surface, so archived
    # reports must stay resolvable (A11.2) even though default LISTS hide them.
    result = api("GET", "/reports?limit=100&include_archived=true")
    reports = result.get("reports", [])
    matches = [r for r in reports if r["id"].startswith(short_id)]
    if not matches:
        # Not on the newest page — the report may simply be older than the
        # first 100, so search the rest of the collection before giving up.
        matches = search_report_prefix(short_id)
    if len(matches) == 1:
        return matches[0]["id"]
    elif len(matches) == 0:
        print(f"❌ No report found with ID prefix: {short_id}", file=sys.stderr)
        sys.exit(1)
    else:
        print(f"❌ Ambiguous ID prefix \"{short_id}\", matches:", file=sys.stderr)
        for m in matches:
            print(f"   {m['id'][:12]}  {m.get('title', '')[:50]}", file=sys.stderr)
        sys.exit(1)

