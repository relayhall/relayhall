# ─── Canonical Project Resources (P1.5f REST contract) ───

UUID_PATTERN = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")
# Password-bearing URL userinfo (user:pass@host). A bare username (git@) is fine.
_URL_CREDENTIAL_PATTERN = re.compile(r"(\w+://)([^/@\s:]+):([^/@\s]+)@")
_SECRET_LIKE_PATTERN = re.compile(
    r"(?i)(bearer\s+\S+"
    r"|[\w-]*(?:secret|token|password|api[-_]?key)[\w-]*\s*[=:]\s*\S+)"
)

def redact_resource_value(value):
    """Human output never prints suspected secrets (--json is the raw envelope)."""
    text = str(value)
    text = _URL_CREDENTIAL_PATTERN.sub(r"\1\2:<redacted>@", text)
    return _SECRET_LIKE_PATTERN.sub("<redacted>", text)

def resolve_resource_project(value):
    """Project argument for the Resource family: UUIDs pass through untouched;
    anything else reuses the existing name resolver (one read, no writes)."""
    if UUID_PATTERN.match(value):
        return value
    return resolve_project_id(value)

def resource_api(method, path, data=None, headers=None):
    """Exactly one authenticated REST call for the Project Resource family.

    Returns (http_status, raw_body_text). Unlike api(), never exits and never
    retries: the caller maps the status onto the stable exit codes."""
    url = f"{get_api_url()}{path}"
    body = json.dumps(data).encode() if data is not None else None
    req = urllib.request.Request(url, data=body, method=method)
    req.add_header("Content-Type", "application/json")
    req.add_header("Authorization", f"Bearer {get_token()}")
    for name, value in (headers or {}).items():
        req.add_header(name, value)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.status, resp.read().decode()
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode()
    except (urllib.error.URLError, OSError) as e:
        message = f"Transport error: {e}"
        return None, json.dumps({"success": False, "error": message, "code": "TRANSPORT_ERROR", "message": message})

def resource_exit_code(status):
    """Stable exit codes: 0 ok, 3 auth/forbidden, 4 absent/concealed,
    5 conflict/stale, 6 validation, 7 transport/server."""
    if status is None:
        return 7
    if status < 400:
        return 0
    if status in (401, 403):
        return 3
    if status == 404:
        return 4
    if status in (409, 412):
        return 5
    if status in (400, 422):
        return 6
    return 7

def resource_usage_error(message):
    print(f"❌ {message}", file=sys.stderr)
    sys.exit(2)

def finish_resource_call(status, body_text, as_json, render=None):
    """Print --json passthrough or human output and exit with the stable code."""
    if as_json:
        print(body_text)
        sys.exit(resource_exit_code(status))
    try:
        envelope = json.loads(body_text)
    except (ValueError, TypeError):
        envelope = {}
    code = resource_exit_code(status)
    if code != 0:
        message = envelope.get("message") or envelope.get("error") or f"HTTP {status}"
        stable = envelope.get("code")
        suffix = f" [{stable}]" if stable else ""
        print(f"❌ {redact_resource_value(message)}{suffix}", file=sys.stderr)
        if envelope.get("suggestion"):
            print(f"   💡 {redact_resource_value(envelope['suggestion'])}", file=sys.stderr)
        sys.exit(code)
    if render:
        render(envelope)
    sys.exit(0)

def format_resource(resource, verbose=False):
    state = resource.get("state", "active")
    icon = "📦" if state == "archived" else "🟢"
    lines = [f"{icon} [{resource.get('kind', '?')}] {resource.get('name', '')} ({state})"]
    lines.append(f"   ID: {resource.get('id', '')}   Revision: {resource.get('revision', '')}")
    if resource.get("description"):
        lines.append(f"   {redact_resource_value(resource['description'])}")
    details = resource.get("details") or {}
    for key, value in details.items():
        if value is not None:
            lines.append(f"   {key}: {redact_resource_value(value)}")
    if verbose:
        lines.append(f"   Visibility: {resource.get('agentVisibility', 'hidden')}   Export: {resource.get('exportPolicy', 'installation-only')}")
        if resource.get("archivedAt"):
            lines.append(f"   Archived at: {resource['archivedAt']}")
    return "\n".join(lines)

def _resource_details_from_args(args, kind):
    details = {}
    if kind == "repository":
        details["url"] = args.url
        if getattr(args, "role", None):
            details["role"] = args.role
        if getattr(args, "default_branch", None):
            details["defaultBranch"] = args.default_branch
    elif kind == "environment":
        details["url"] = args.url
        details["stage"] = args.stage
    elif kind == "workspace":
        details["path"] = args.path
        details["purpose"] = args.purpose
    elif kind == "reference":
        details["url"] = args.url
        details["category"] = args.category
    return details

def _resource_body_from_args(args, kind):
    for attr, flag in RESOURCE_KIND_REQUIRED_DETAILS[kind]:
        if not getattr(args, attr, None):
            resource_usage_error(f"{flag} is required for kind '{kind}'")
    body = {"kind": kind, "name": args.name, "details": _resource_details_from_args(args, kind)}
    if getattr(args, "description", None) is not None:
        body["description"] = args.description
    if getattr(args, "agent_visibility", None):
        body["agentVisibility"] = args.agent_visibility
    if getattr(args, "export_policy", None):
        body["exportPolicy"] = args.export_policy
    return body

