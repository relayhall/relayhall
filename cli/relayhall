def _read_private_key(path):
    """Read a PEM private key from disk. Never echoed, never logged, and never
    passed as an argument — argv is world-readable in the process table.

    Validates a COMPLETE PEM envelope, not a marker substring: round-4 review
    (R3 B1) proved a file whose entire contents were "PRIVATE KEY" sailed
    through a substring check and was POSTed as the key. The armor labels must
    match, carry a private-key label, and enclose base64 that actually decodes
    to something.
    """
    if not path:
        return None
    try:
        with open(path, "r", encoding="utf-8") as handle:
            key = handle.read().strip()
    except OSError as err:
        print(f"❌ Could not read the private key file: {err}", file=sys.stderr)
        sys.exit(2)
    if not key:
        print("❌ The private key file is empty.", file=sys.stderr)
        sys.exit(2)
    envelope = re.match(
        r"^-----BEGIN ((?:[A-Z0-9 ]*?)PRIVATE KEY)-----\n"
        r"([A-Za-z0-9+/=\n\r]+)"
        r"-----END \1-----$",
        key,
    )
    if not envelope:
        print("❌ That file does not look like a PEM private key "
              "(expected a BEGIN/END PRIVATE KEY envelope with matching labels).",
              file=sys.stderr)
        sys.exit(2)
    import base64 as _b64
    body = "".join(envelope.group(2).split())
    try:
        decoded = _b64.b64decode(body, validate=True)
    except Exception:
        decoded = b""
    if len(decoded) < 16:
        print("❌ The PEM body is not decodable key material.", file=sys.stderr)
        sys.exit(2)
    return key


