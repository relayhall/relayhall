        return result.get("version", {}).get("skill_md")

    # Build effective skills map
    effective = {}

    # Add global skills first
    for t in all_skills:
        if t.get("is_global"):
            effective[t["id"]] = {
                "name": t["name"],
                "category": t.get("category") or "uncategorized",
                "description": t.get("description"),
                "instructions": full_content(t, t.get("current_published_version_id")),
                "source": "🌐 global",
                "has_override": False,
            }

    # Add/override with project-linked skills
    for ps in project_skills:
        skill = ps.get("skill", ps)
        skill_id = skill.get("id", ps.get("skill_id", ""))
        version_id = ps.get("skill_version_id")

        effective[skill_id] = {
            "name": skill.get("name", "Unknown"),
            "category": skill.get("category") or "uncategorized",
            "description": skill.get("description"),
            "instructions": full_content(skill, version_id),
            "source": f"📌 exact pin {str(version_id)[:8]}",
            "has_override": False,
        }

    if not effective:
        print("No effective skills for this project.")
        return

    # Output markdown-like format
    print(f"─── Effective Skill Context ({len(effective)} skills) ───\n")

    # Group by category
    by_category = {}
    for sid, info in effective.items():
        cat = info["category"]
        by_category.setdefault(cat, []).append(info)

    for cat in sorted(by_category.keys()):
        print(f"## {cat.upper()}\n")
        for info in sorted(by_category[cat], key=lambda x: x["name"]):
            print(f"### {info['name']}  [{info['source']}]")
            if info.get("description"):
                print(f"  {info['description']}")
            if info.get("instructions"):
                print(f"\n  {info['instructions']}\n")
            else:
                print(f"  (no usage instructions)\n")

    print("───────────────────────────────────────────")

