def load_report_handover(args):
    """Load an optional structured handover from inline JSON or a file.

    Shape validation remains authoritative in REST; the CLI fails early on
    malformed JSON and non-object roots so it never sends an accidental
    string/list representation.
    """
    raw = getattr(args, "handover", None)
    path = getattr(args, "handover_file", None)
    if path:
        try:
            with open(path, "r", encoding="utf-8") as handle:
                raw = handle.read()
        except FileNotFoundError:
            print(f"❌ File not found: {path}", file=sys.stderr)
            sys.exit(1)
    if raw is None:
        return None
    try:
        value = json.loads(raw)
    except json.JSONDecodeError as exc:
        print(f"❌ Invalid handover JSON: {exc.msg} at line {exc.lineno} column {exc.colno}", file=sys.stderr)
        sys.exit(1)
    if not isinstance(value, dict):
        print("❌ Handover JSON must be an object", file=sys.stderr)
        sys.exit(1)
    return value


def cmd_report_create(args):
    """Create a report."""
    if not args.content and not args.file:
        print("❌ --content or --file is required", file=sys.stderr)
        sys.exit(1)

    content = args.content
    if args.file:
        try:
            with open(args.file, "r") as f:
                content = f.read()
        except FileNotFoundError:
            print(f"❌ File not found: {args.file}", file=sys.stderr)
            sys.exit(1)

    data = {
        "title": args.title,
        "content": content,
    }

    if args.summary:
        data["summary"] = args.summary
    if args.tags:
        data["tags"] = [t.strip() for t in args.tags.split(",") if t.strip()]
    if args.project:
        data["project_id"] = resolve_project_id(args.project)
    if args.tasks:
        task_ids = []
        for tid in args.tasks.split(","):
            tid = tid.strip()
            if tid:
                task_ids.append(resolve_task_id(tid))
        data["task_ids"] = task_ids
    if args.pinned:
        if is_automation_context():
            print("ℹ️  Ignoring --pinned: pinning reports is a human/on-demand action, not an agent default.", file=sys.stderr)
        else:
            data["pinned"] = True
    handover = load_report_handover(args)
    if handover is not None:
        data["handover"] = handover

    result = api("POST", "/reports", data)
    report = result.get("report", result)

    full_id = report.get('id', 'N/A')
    print(f"✅ Created report: {args.title}")
    print(f"   ID: {full_id}")
    if report.get("tags"):
        print(f"   Tags: {', '.join(report['tags'])}")
    if report.get("pinned"):
        print(f"   📌 Pinned")
    dash = get_dashboard_url()
    if dash:
        print(f"   🔗 {dash}/reports/{full_id}")

def cmd_report_get(args):
