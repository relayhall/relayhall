def cmd_principal_role(args):
    """Change a principal's role (owner ruling 60307311 §1.2).

    A LOGIN-SESSION act: it is performed with the credential `relayhall login`
    caches, never with an `rh_` principal key — a bearer credential that could
    hand out roles would be privilege escalation in one hop (AZ-18). The
    server bounds what this session may assign (`canAssignRole`), refuses the
    caller's own row, refuses the break-glass identity, and refuses an
    elevated role on anything but a parentless human Account.
    """
    principal_id = _resolve_principal_id(args.principal)
    result = api("POST", f"/principals/{principal_id}/role", {"role": args.role}, exit_on_error=False)
    if not result.get("success"):
        print(f"❌ Role change refused: {result.get('message') or result.get('error')}", file=sys.stderr)
        if result.get("code") in ("ROLE_ACT_REQUIRES_SESSION", "ROLE_ACT_REQUIRES_ADMINISTRATOR"):
            print("   Changing a role is a login-session act: run `relayhall login` as an administrator first.", file=sys.stderr)
        sys.exit(1)
    p = result.get("principal", {})
    print(f"✅ {p.get('handle')}: role {result.get('previousRole') or '-'} → {p.get('role')}")
    print(f"   {result.get('note') or 'Takes effect on that Account next request.'}")

def cmd_principal_set_password(args):
    """Give a human Account its login password (card bc5cd9f0).

    THE GAP THIS FILLS. On a default install with no Identity provider, a second
    person's Account had no shipped way to get a first password: the Identities
    row offered only Disable, `invitation mint` needs a provider a fresh install
    does not have, and the one-time first-run act closes after the first
    administrator. The REST route existed and worked; onboarding a colleague
    meant hand-written HTTP.

    A LOGIN-SESSION ACT. Performed with the credential `relayhall login` caches,
    never with an `rh_` principal key: a bearer credential that could give a
    human Account a password could manufacture a human identity for whoever
    holds the key, which is the shape AZ-18 forbids. The server bounds what this
    session may reach by `canAssignRole` — the same ceiling the role verb obeys
    — refuses the break-glass identity, and audits every attempt.

    THE PASSWORD IS NEVER AN ARGUMENT. A value on argv lands in shell history
    and in every `ps` listing on the machine. It is prompted for, twice, or read
    from stdin when a script has one to pipe.
    """
    principal_id = _resolve_principal_id(args.principal)

    if args.stdin:
        password = sys.stdin.readline().rstrip("\n")
        if not password:
            print("❌ No password on stdin.", file=sys.stderr)
            sys.exit(1)
    else:
        import getpass
        password = getpass.getpass("New password: ")
        again = getpass.getpass("Type it again: ")
        if password != again:
            print("❌ The two entries do not match. Nothing was changed.", file=sys.stderr)
            sys.exit(1)

    # No length or byte check here. THE policy lives once on the server
    # (AccountPasswordService.checkPasswordPolicy, shared with the first-run
    # act) and a mirror in the CLI would be a second place it could differ; a
    # value the board will not take comes back refused by name.
    result = api("PUT", f"/principals/{principal_id}/password", {"password": password}, exit_on_error=False)
    if not result.get("success"):
        print(f"❌ Set password refused: {result.get('message') or result.get('error')}", file=sys.stderr)
        code = result.get("code")
        if code in ("PASSWORD_ACT_REQUIRES_SESSION", "PASSWORD_ACT_REQUIRES_ADMINISTRATOR"):
            print("   Setting a password is a login-session act: run `relayhall login` as an administrator first.", file=sys.stderr)
        elif code == "PASSWORD_ABOVE_YOUR_AUTHORITY":
            print("   You may only set a password for an Account whose role you could assign yourself.", file=sys.stderr)
        sys.exit(1)
    print(f"✅ {args.principal}: password set")
    print(f"   {result.get('note') or 'That Account can sign in with this password now.'}")


