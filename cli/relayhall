def _fetched_at(value):
    """A discovery cache timestamp, or an honest statement that it is cold.

    The import is local: this module has no module-scope datetime, and adding
    one would change what four other call sites print (they sit inside bare
    excepts that have been swallowing the NameError). Filed separately.
    """
    from datetime import datetime as _datetime, timezone as _timezone
    if not value:
        return "never (cache cold — the next login warms it)"
    try:
        return _datetime.fromtimestamp(value / 1000, tz=_timezone.utc).isoformat()
    except (TypeError, ValueError, OSError, OverflowError):
        return str(value)


def _identity_provider_line(p):
    flags = []
    if p.get("allowPrivateIssuerAddress"):
        flags.append("private-address")
    if p.get("allowClaimMatching"):
        flags.append("claim-matching")
    if p.get("retainIdToken"):
        flags.append("retains-id-token")
    if not p.get("subjectImmutable"):
        flags.append("SUBJECT-NOT-IMMUTABLE")
    return (
        f"{p['id']}  {p.get('name') or '-':<24} {p.get('status') or '-':<9} "
        f"{p.get('provisioningMode') or '-':<9} secret={'yes' if p.get('hasClientSecret') else 'no':<3} "
        f"{p.get('issuer') or '-'}"
        + (f"  [{', '.join(flags)}]" if flags else "")
    )


