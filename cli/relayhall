def _read_optional_text_arg(text_value=None, file_path=None):
    if text_value and file_path:
        print("❌ Use either inline text or the corresponding --*-file, not both.", file=sys.stderr)
        sys.exit(1)
    if file_path:
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                return f.read()
        except FileNotFoundError:
            print(f"❌ File not found: {file_path}", file=sys.stderr)
            sys.exit(1)
    return text_value

def _parse_list_text(value):
    if not value:
        return []
    items = []
    for raw in re.split(r'[\n;]', value):
        item = raw.strip()
        if item.startswith('- '):
            item = item[2:].strip()
        if item:
            items.append(item)
    return items

def build_report_link(input_value):
    if not input_value:
        return None
    raw = input_value.strip()
    if raw.startswith('http://') or raw.startswith('https://'):
        report_url = raw
        match = re.search(r'/reports/([0-9a-fA-F-]{8,})', raw)
        report_id = match.group(1) if match else None
    else:
        report_id = resolve_report_id(raw)
        dash = get_dashboard_url()
        report_url = f"{dash}/reports/{report_id}" if dash else f"/reports/{report_id}"
    title = 'Linked report'
    if report_id:
        try:
            rep = api('GET', f'/reports/{report_id}', exit_on_error=False)
            if rep.get('success') and rep.get('report'):
                title = rep['report'].get('title') or title
        except Exception:
            pass
    return {"type": "report", "title": title, "url": report_url}


def _split_typed_entry(entry, flag):
    """`key=value` keeps the value as the EXACT string; `key:=json` parses the
    value as JSON for booleans/numbers (or any typed literal). Explicit syntax
    instead of guessing: a Connector that declares the string "true" or "001"
    must be able to receive it verbatim (review 66c78a1d F2)."""
    if ":=" in entry and ("=" not in entry or entry.index(":=") <= entry.index("=")):
        path, raw = entry.split(":=", 1)
        try:
            return path, json.loads(raw)
        except ValueError:
            print(f"❌ {flag} {path}:= expects a JSON literal (true, false, 1.5, \"text\"), got: {raw}", file=sys.stderr)
            sys.exit(2)
    if "=" in entry:
        path, raw = entry.split("=", 1)
        return path, raw
    print(f"❌ {flag} must be key=value (exact string) or key:=json (typed), got: {entry}", file=sys.stderr)
    sys.exit(2)

def build_connector_profile(args):
    """Connector-first execution profile (D-15): --service [--descriptor-version]
    [--option key=value ...] [--parameter optionKey.paramKey=value ...].
    Returns None when no profile flags were given."""
    service = getattr(args, "service", None)
    options = getattr(args, "option", None) or []
    parameters = getattr(args, "parameter", None) or []
    version = getattr(args, "descriptor_version", None)
    if not service:
        if options or parameters or version is not None:
            print("❌ --option/--parameter/--descriptor-version require --service", file=sys.stderr)
            sys.exit(2)
        return None
    profile = {"serviceId": service}
    if version is not None:
        try:
            profile["descriptorVersion"] = int(version)
        except ValueError:
            print("❌ --descriptor-version must be a positive integer", file=sys.stderr)
            sys.exit(2)
    opts = {}
    for entry in options:
        key, value = _split_typed_entry(entry, "--option")
        opts[key] = value
    profile["options"] = opts
    if parameters:
        params = {}
        for entry in parameters:
            path, value = _split_typed_entry(entry, "--parameter")
            if "." not in path:
                print(f"❌ --parameter must be optionKey.paramKey=value or optionKey.paramKey:=json, got: {entry}", file=sys.stderr)
                sys.exit(2)
            option_key, param_key = path.split(".", 1)
            params.setdefault(option_key, {})[param_key] = value
        profile["parameters"] = params
    return profile

def cmd_create(args):
    data = {"title": args.title}

    execution_profile = build_connector_profile(args)

    # Warn if no subtasks provided (unless suppressed)
    has_subtasks = bool(args.subtasks) or bool(getattr(args, 'add_subtask', None))
    no_subtasks_flag = getattr(args, 'no_subtasks', False)
    if not has_subtasks and not no_subtasks_flag:
        if not confirm_prompt("⚠️ Creating task without subtasks. Continue? (y/N): "):
            print("Aborted.", file=sys.stderr)
            sys.exit(1)
    
    if args.status:
        data["status"] = validate_status(args.status)
    else:
        data["status"] = "ideas"
    
    if args.priority:
        if args.priority not in VALID_PRIORITIES:
            print(f"❌ Invalid priority: {args.priority}. Valid: {', '.join(VALID_PRIORITIES)}", file=sys.stderr)
            sys.exit(1)
        data["priority"] = args.priority
    else:
        data["priority"] = "normal"
    
    if args.project:
        data["project"] = resolve_project(args.project)

    # Phase membership (RH-P2.4). The phase must belong to the same project;
    # the server refuses a mismatch outright rather than silently repairing it.
    if getattr(args, "phase", None):
        data["phaseId"] = args.phase

    if args.description:
        data["description"] = args.description

    # Card 9c3a1aa4: create accepts the same notes update accepts. Before the
    # repair the server took this field and dropped it, so a caller that wanted
    # notes at creation had to follow every create with an update.
    if args.notes:
        data["notes"] = args.notes

    # Card 7d38a6e0. Sent only when the flag is given: a Task with no
    # deadline is the ordinary state, not a value to be defaulted.
    if getattr(args, "due", None):
        data["dueAt"] = args.due

    if args.subtasks:
        data["subtasks"] = parse_subtasks(args.subtasks)

    definition_of_done = _read_optional_text_arg(getattr(args, 'definition_of_done', None), getattr(args, 'definition_of_done_file', None))
    if definition_of_done is not None:
        parsed = _parse_list_text(definition_of_done)
        data["definitionOfDone"] = parsed if parsed else definition_of_done

    constraints = _read_optional_text_arg(getattr(args, 'constraints', None), getattr(args, 'constraints_file', None))
    if constraints is not None:
        parsed = _parse_list_text(constraints)
        data["constraints"] = parsed if parsed else constraints

    if getattr(args, 'report', None):
        data["links"] = [link for link in (build_report_link(ref) for ref in args.report) if link]
    
    if args.tags:
        data["tags"] = [t.strip() for t in args.tags.split(",") if t.strip()]
    definition_of_done = _read_optional_text_arg(getattr(args, 'definition_of_done', None), getattr(args, 'definition_of_done_file', None))
    if definition_of_done is not None:
        parsed = _parse_list_text(definition_of_done)
        data["definitionOfDone"] = parsed if parsed else definition_of_done
    constraints = _read_optional_text_arg(getattr(args, 'constraints', None), getattr(args, 'constraints_file', None))
    if constraints is not None:
        parsed = _parse_list_text(constraints)
        data["constraints"] = parsed if parsed else constraints
    
    if args.blocked_by:
        data["blockedBy"] = [b.strip() for b in args.blocked_by.split(",") if b.strip()]
    
    if args.depends_on:
        data["dependsOn"] = [d.strip() for d in args.depends_on.split(",") if d.strip()]
    
    # Always send an explicit autoStart: default FALSE (lifecycle gate — the
    # orchestrator must not auto-pick tasks nobody opted in for pickup).
    data["autoStart"] = (args.auto_start == "true")
    
    if args.thinking:
        data["thinking"] = args.thinking
    
    if getattr(args, 'model', None):
        data["model"] = args.model
    if execution_profile:
        data["executionProfile"] = execution_profile

    personalities = _fetch_personalities()
    if getattr(args, 'personality', None):
        # Resolve personality slug/id/name → ID via API/list
        resolved = None
        at_resp = api("GET", f"/personalities/{args.personality}", exit_on_error=False)
        if at_resp.get("success") and at_resp.get("personality"):
            resolved = at_resp["personality"]

        if not resolved:
            needle = args.personality.strip().lower()
            for at in personalities:
                if needle in {
                    str(at.get("id", "")).lower(),
                    str(at.get("slug", "")).lower(),
                    str(at.get("name", "")).lower(),
                }:
                    resolved = at
                    break

        if resolved:
            data["personalityId"] = resolved["id"]
        else:
            print(f"❌ Personality '{args.personality}' not found.", file=sys.stderr)
            _print_personality_help(personalities)
            sys.exit(1)
    else:
        generalist = next((item for item in personalities if item.get("slug") == "generalist"), None)
        if generalist:
            data["personalityId"] = generalist["id"]

    result = api("POST", "/tasks", data)
    task = result.get("task", {})
    full_id = task.get('id', '')
    task_id_short = full_id[:8] if full_id else 'TASKID'
    print(f"✅ Created: {format_task(task)}")
    print(f"   ID: {full_id}")
    
    # Remind about model and thinking if not set
    reminders = []
    if not data.get("model"):
        reminders.append("--model <openclaw-model-id>")
    if not data.get("thinking"):
        reminders.append("--thinking (low/medium/high)")
    if reminders:
        print(f"   💡 Consider setting: {', '.join(reminders)} — agents use the configured default model and low thinking if unset")
    
    dash = get_dashboard_url()
    if dash:
        print(f"   🔗 {dash}/tasks?focus={full_id}")

    # Post-creation warnings (always show, even in agent context)
    sys.stdout.flush()
    warnings = []

    # Check for missing subtasks
    task_subtasks = task.get('subtasks') or []
    if not task_subtasks:
        warnings.append(f'⚠️  No subtasks — agents work better with clear checkpoints. Add with: relayhall update {task_id_short} --subtasks "sub1;sub2"')

    # Check for missing project
    if not task.get('project'):
        warnings.append(f'⚠️  No project linked — tasks should belong to a project. Add with: relayhall update {task_id_short} --project <name>')

    # Check for missing description
    if not task.get('description'):
        warnings.append(f'⚠️  No description — agents need context to work effectively. Add with: relayhall update {task_id_short} --description "..."')

    if warnings:
        print('', file=sys.stderr)
        print('   ⚠️  WARNINGS:', file=sys.stderr)
        for w in warnings:
            print(f'   {w}', file=sys.stderr)

    # Model/thinking hint when neither was explicitly set at creation time
    # (model is not a create arg; thinking defaults to low when omitted — so check args)
    user_set_thinking = bool(getattr(args, 'thinking', None))
    task_has_model = bool(task.get('model'))
    if not task_has_model and not user_set_thinking:
        print('   💡 Consider setting: --model <openclaw-model-id>, --thinking (low/medium/high) — agents use the configured default model and low thinking if unset', file=sys.stderr)

def cmd_update(args):
    task_id = resolve_task_id(args.id)
    data = {}
    
    if args.status:
        data["status"] = validate_status(args.status)
    if args.priority:
        data["priority"] = args.priority
    if args.project:
        data["project"] = resolve_project(args.project)
    # Phase membership (RH-P2.4): --phase sets it, --clear-phase unphases
    # (back to the project backlog). Both are explicit; neither is a default.
    if getattr(args, "phase", None):
        data["phaseId"] = args.phase
    if getattr(args, "clear_phase", False):
        data["phaseId"] = None
    if args.description:
        data["description"] = args.description
    if args.title:
        data["title"] = args.title
    if args.tags:
        data["tags"] = [t.strip() for t in args.tags.split(",") if t.strip()]
    if args.subtasks:
        data["subtasks"] = parse_subtasks(args.subtasks)
    if args.depends_on:
        data["dependsOn"] = [d.strip() for d in args.depends_on.split(",") if d.strip()]
    if args.notes:
        data["notes"] = args.notes
    # Card 7d38a6e0. `--due ""` is how a deadline is REMOVED, so presence
    # of the flag decides, not truthiness of its value.
    due = getattr(args, "due", None)
    if due is not None:
        data["dueAt"] = due or None
    if args.thinking:
        data["thinking"] = args.thinking
    if getattr(args, 'model', None):
        data["model"] = args.model
    if getattr(args, "clear_profile", False):
        data["executionProfile"] = None
    else:
        execution_profile = build_connector_profile(args)
        if execution_profile:
            data["executionProfile"] = execution_profile
    if hasattr(args, 'auto_start') and args.auto_start is not None:
        data["autoStart"] = args.auto_start == "true"
    if getattr(args, 'personality', None):
        at_resp = api("GET", f"/personalities/{args.personality}")
        if at_resp.get("success") and at_resp.get("personality"):
            data["personalityId"] = at_resp["personality"]["id"]
        else:
            print(f"⚠️  Personality '{args.personality}' not found", file=sys.stderr)
            sys.exit(1)
    if getattr(args, 'report', None):
        current = api("GET", f"/tasks/{task_id}")
        existing_links = current.get("task", {}).get("links") or []
        for report_ref in args.report:
            link = build_report_link(report_ref)
            if link and not any(l.get('url') == link['url'] for l in existing_links):
                existing_links.append(link)
        data["links"] = existing_links
    if args.add_subtask:
        # Fetch current, append
        current = api("GET", f"/tasks/{task_id}")
        existing = current.get("task", {}).get("subtasks") or []
        new_subs = parse_subtasks(args.add_subtask)
        data["subtasks"] = existing + new_subs
    

    # --definition-of-done / --constraints used to be SILENT NO-OPS on update
    # (parsed by argparse, never added to the payload). Mirrors cmd_create.
    definition_of_done = _read_optional_text_arg(getattr(args, 'definition_of_done', None), getattr(args, 'definition_of_done_file', None))
    if definition_of_done is not None:
        parsed = _parse_list_text(definition_of_done)
        data["definitionOfDone"] = parsed if parsed else definition_of_done

    constraints = _read_optional_text_arg(getattr(args, 'constraints', None), getattr(args, 'constraints_file', None))
    if constraints is not None:
        parsed = _parse_list_text(constraints)
        data["constraints"] = parsed if parsed else constraints

    if not data:
        print("Nothing to update. Use --status, --priority, --project, etc.", file=sys.stderr)
        sys.exit(1)
    
    result = api("PATCH", f"/tasks/{task_id}", data)
    task = result.get("task", {})
    print(f"✅ Updated: {format_task(task)}")

def cmd_move(args):
    task_id = resolve_task_id(args.id)
    status = validate_status(args.status)
    
    # Guardrail: block move to completed if subtasks not done (unless --force)
    # Done = completed OR skipped
    force = getattr(args, 'force', False)
    if status == "completed" and not force:
        # Fetch current task to check subtasks
        current = api("GET", f"/tasks/{task_id}")
        task = current.get("task", current)
        subtasks = task.get("subtasks") or []
        
        if subtasks:
            # Check if all subtasks are done (completed or skipped)
            not_done = []
            for i, s in enumerate(subtasks):
                s_status = s.get("status", "empty")
                # Normalize old status names
                if s_status == "new":
                    s_status = "empty"
                if s_status == "in_review":
                    s_status = "review"
                if s_status not in ("completed", "skipped"):
                    not_done.append((i, s_status, s.get("text", "???")))
            
            if not_done:
                # Block the move and show helpful error
                print(f"❌ Cannot move to completed — {len(not_done)} subtask(s) not done:", file=sys.stderr)
                for idx, s_status, text in not_done:
                    icon = format_subtask_status({"status": s_status})
                    print(f"  [{idx}] {icon} {s_status}: \"{text}\"", file=sys.stderr)
                print(f"\nRun: relayhall review {task_id[:8]}", file=sys.stderr)
                print(f"Or use --force to override this check.", file=sys.stderr)
                sys.exit(1)
    
    if force:
        confirm = getattr(args, "confirm_override", False)
        if not confirm:
            print("⚠️ ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━", file=sys.stderr)
            print("⚠️  FORCE MOVE — Maintenance/Troubleshooting/Testing ONLY!", file=sys.stderr)
            print("⚠️  This bypasses ALL guardrails (subtask checks, review flow).", file=sys.stderr)
            print("⚠️  Normal workflow: approve subtasks → move to review → completed", file=sys.stderr)
            print("⚠️ ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━", file=sys.stderr)
            print("\nTo confirm, re-run with --force --confirm-override", file=sys.stderr)
            sys.exit(1)
        print("⚠️ Force override CONFIRMED: skipping all guardrail checks.", file=sys.stderr)

    # DoD gate (non-blocking): warn when promoting ideas -> todo without a
    # definitionOfDone. The move still proceeds — this is a nudge, not a block.
    if status == "todo":
        current = api("GET", f"/tasks/{task_id}", exit_on_error=False)
        cur_task = current.get("task", current) if isinstance(current, dict) else {}
        if cur_task.get("status") == "ideas":
            dod = cur_task.get("definitionOfDone")
            dod_present = bool(dod.strip()) if isinstance(dod, str) else bool(dod)
            if not dod_present:
                print("⚠️  WARNING: moving ideas → todo without a definitionOfDone.", file=sys.stderr)
                print(f"   Add one first: relayhall update {task_id[:8]} --definition-of-done \"...\"", file=sys.stderr)
                print("   (Move proceeds anyway — this is a warning, not a block.)", file=sys.stderr)

    data = {"status": status}
    if args.notes:
        data["notes"] = args.notes
    if is_agent_context():
        data["role"] = "agent"
    result = api("PATCH", f"/tasks/{task_id}", data)
    task = result.get("task", {})
    if result.get("warning"):
        print(f"⚠️  {result['warning']}", file=sys.stderr)
    print(f"✅ Moved: {format_task(task)}")

