{
  "note": "Narrow-only cases for the connector trust-policy override (design v1.5 section 4.3, B3). Read by cli/test_connector_trust.py (the connector applies the rule) and by backend/src/__tests__/connectorTrustPolicy.test.ts (the board applies it before serving), so the two rules cannot drift apart. `rejected` lists [path, code] pairs.",
  "cases": [
    {"name": "no override", "override": null, "accepted": {}, "rejected": []},
    {"name": "wrong schema", "override": {"schemaVersion": "rh.connector-trust-override/2", "products": {}}, "accepted": {}, "rejected": [["", "OVERRIDE_MALFORMED"]]},
    {"name": "not an object", "override": ["codex"], "accepted": {}, "rejected": [["", "OVERRIDE_MALFORMED"]]},
    {"name": "empty", "override": {"schemaVersion": "rh.connector-trust-override/1", "products": {}}, "accepted": {}, "rejected": []},
    {"name": "raise the minimum", "override": {"schemaVersion": "rh.connector-trust-override/1", "products": {"codex": {"windows": {"minimumVersion": "26.1021.0.0"}}}},
     "accepted": {"codex": {"windows": {"minimumVersion": "26.1021.0.0"}}}, "rejected": []},
    {"name": "the same minimum", "override": {"schemaVersion": "rh.connector-trust-override/1", "products": {"claude-code": {"windows": {"minimumVersion": "2.1.246"}}}},
     "accepted": {"claude-code": {"windows": {"minimumVersion": "2.1.246"}}}, "rejected": []},
    {"name": "lower the minimum (widening)", "override": {"schemaVersion": "rh.connector-trust-override/1", "products": {"codex": {"windows": {"minimumVersion": "26.1013.4894.0"}}}},
     "accepted": {}, "rejected": [["products.codex.windows.minimumVersion", "OVERRIDE_LOWERS_MINIMUM"]]},
    {"name": "deny versions", "override": {"schemaVersion": "rh.connector-trust-override/1", "products": {"codex": {"windows": {"denyVersions": ["26.1021.3705.0", "26.1016.8120.0", "26.1021.3705.0"]}}}},
     "accepted": {"codex": {"windows": {"denyVersions": ["26.1016.8120.0", "26.1021.3705.0"]}}}, "rejected": []},
    {"name": "a malformed deny version", "override": {"schemaVersion": "rh.connector-trust-override/1", "products": {"claude-code": {"windows": {"denyVersions": ["2.1"]}}}},
     "accepted": {}, "rejected": [["products.claude-code.windows.denyVersions", "OVERRIDE_MALFORMED"]]},
    {"name": "remove a publisher", "override": {"schemaVersion": "rh.connector-trust-override/1", "products": {"claude-code": {"windows": {"removePublishers": ["anthropic-digicert-ev"]}}}},
     "accepted": {"claude-code": {"windows": {"removePublishers": ["anthropic-digicert-ev"]}}}, "rejected": []},
    {"name": "remove an unknown publisher", "override": {"schemaVersion": "rh.connector-trust-override/1", "products": {"codex": {"windows": {"removePublishers": ["openai-microsoft-store", "someone-else"]}}}},
     "accepted": {"codex": {"windows": {"removePublishers": ["openai-microsoft-store"]}}}, "rejected": [["products.codex.windows.removePublishers", "OVERRIDE_UNKNOWN_PUBLISHER"]]},
    {"name": "add a publisher (widening)", "override": {"schemaVersion": "rh.connector-trust-override/1", "products": {"codex": {"windows": {"publishers": [{"id": "evil"}], "denyVersions": ["26.1017.0.0"]}}}},
     "accepted": {"codex": {"windows": {"denyVersions": ["26.1017.0.0"]}}}, "rejected": [["products.codex.windows.publishers", "OVERRIDE_WIDENING_FIELD"]]},
    {"name": "replace a signer or an anchor (widening)", "override": {"schemaVersion": "rh.connector-trust-override/1", "products": {"claude-code": {"windows": {"binarySigner": {"subject": "CN=Evil"}, "anchors": [], "kind": "msix"}}}},
     "accepted": {}, "rejected": [["products.claude-code.windows.binarySigner", "OVERRIDE_WIDENING_FIELD"], ["products.claude-code.windows.anchors", "OVERRIDE_WIDENING_FIELD"], ["products.claude-code.windows.kind", "OVERRIDE_WIDENING_FIELD"]]},
    {"name": "trust a product the release does not (widening)", "override": {"schemaVersion": "rh.connector-trust-override/1", "products": {"gemini-cli": {"windows": {"minimumVersion": "1.0.0"}}, "codex": {"macos": {"minimumVersion": "1.0.0.0"}}}},
     "accepted": {}, "rejected": [["products.gemini-cli.windows", "OVERRIDE_UNKNOWN_PRODUCT"], ["products.codex.macos", "OVERRIDE_UNKNOWN_PRODUCT"]]},
    {"name": "an unknown top-level field", "override": {"schemaVersion": "rh.connector-trust-override/1", "products": {}, "ceiling": {"products": {}}},
     "accepted": {}, "rejected": [["ceiling", "OVERRIDE_UNKNOWN_FIELD"]]},
    {"name": "a malformed product entry", "override": {"schemaVersion": "rh.connector-trust-override/1", "products": {"codex": ["windows"], "claude-code": {"windows": "deny-all"}}},
     "accepted": {}, "rejected": [["products.codex", "OVERRIDE_MALFORMED"], ["products.claude-code.windows", "OVERRIDE_MALFORMED"]]},
    {"name": "products not an object", "override": {"schemaVersion": "rh.connector-trust-override/1", "products": []},
     "accepted": {}, "rejected": [["products", "OVERRIDE_MALFORMED"]]}
  ]
}
