# RelayHall environment configuration
# Copy this file to .env and update values

# =====================================================
# DATABASE
# =====================================================
POSTGRES_DB=relayhall
POSTGRES_USER=relayhall
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_HOST_PORT=5433

# =====================================================
# AUTHENTICATION
# =====================================================
# JWT secret for token signing (generate with: openssl rand -hex 64)
JWT_SECRET=change-this-to-a-random-string

# Dashboard login password hash (bcrypt)
# Generated during setup.sh, or manually (installs backend deps first):
#   cd backend && npm ci && node scripts/hash-password.js yourpassword
DASHBOARD_PASSWORD_HASH=changeme

# Enable named Account sign-in and first-administrator setup.
# Explicit off is for deployments intentionally retaining legacy login only.
RELAYHALL_SESSIONS=on

# =====================================================
# KEY SETS (not in this file: relayhall.keys.env)
# =====================================================
# The backend keeps four key sets outside the database. ./setup.sh generates
# them once, with random values, into relayhall.keys.env (mode 600, ignored
# by git), which docker-compose.yml passes to the backend. Re-running
# ./setup.sh never changes a key that exists; on an install that has none it
# generates them, which is safe. Values set here in .env are NOT passed to the
# backend (setup.sh copies a complete pair it finds here into
# relayhall.keys.env, unchanged).
#
# Each set is a JSON object of { "<key id>": "<base64 key>" } plus the id of
# the active key, for example:
#   RELAYHALL_CREDENTIAL_KEYS='{"credential-20261025":"<base64 of 32 random bytes>"}'
#   RELAYHALL_CREDENTIAL_ACTIVE_KEY=credential-20261025
#
# RELAYHALL_CREDENTIAL_KEYS / RELAYHALL_CREDENTIAL_ACTIVE_KEY
#   32-byte keys (AES-256-GCM) that encrypt credential secrets. Without them
#   the backend refuses to issue credentials, so connecting an agent fails.
# RELAYHALL_TELEMETRY_PEPPERS / RELAYHALL_TELEMETRY_ACTIVE_PEPPER
#   32-byte peppers that pseudonymize telemetry. Without them telemetry and
#   OTLP ingest are refused, MCP sessions and their action log are not
#   recorded, and the native session protocols refuse.
# RELAYHALL_KNOWLEDGE_HANDLE_KEYS / RELAYHALL_KNOWLEDGE_HANDLE_ACTIVE_KEY
#   32-byte keys that seal knowledge result links. Without them a knowledge
#   search that finds results fails.
# RELAYHALL_KNOWLEDGE_ASSERTION_KEYS / RELAYHALL_KNOWLEDGE_ASSERTION_ACTIVE_KEY
#   Ed25519 private keys, PKCS#8 DER in base64 (openssl genpkey -algorithm
#   ed25519 -outform DER | openssl base64 -A), that sign the board's caller
#   assertions. Without them a knowledge source that checks caller assertions
#   is left out of every search, and a source's return bundle carries no
#   public key, so create them before registering such a source.
#
# NEVER ROTATE OR REPLACE A KEY CASUALLY. Credential secrets and pseudonymized
# telemetry stored under a key cannot be read without it, and once such rows
# exist the backend refuses to start without it. A replaced assertion key
# breaks every source registered with the old public key; a replaced handle
# key invalidates outstanding result links. Back up relayhall.keys.env
# whenever you back up the database, and store that copy apart from the dumps.

# =====================================================
# SERVER
# =====================================================
# Backend API host port (the container always listens on 3001)
BACKEND_PORT=3001

# Frontend port (exposed to host)
FRONTEND_PORT=8082

# OTLP/gRPC receiver (optional; docs/observability.md). Empty = no listener.
# The overlay docker-compose.otlp-grpc.yml turns it on at container port 4317
# and publishes it on OTLP_GRPC_BIND_ADDRESS:OTLP_GRPC_HOST_PORT (loopback by
# default). Setting the port here without the overlay serves it on the compose
# network only.
RELAYHALL_OTLP_GRPC_PORT=
# OTLP_GRPC_BIND_ADDRESS=127.0.0.1
# OTLP_GRPC_HOST_PORT=4317

# Node environment
NODE_ENV=production

# Generic lifecycle-policy seam (Phase 2 contract only). `off` is the safe
# default until a separately reviewed evaluator package and policy are bound.
RELAYHALL_LIFECYCLE_POLICY_MODE=off
RELAYHALL_LIFECYCLE_POLICY_ID=relayhall.contract-only
RELAYHALL_LIFECYCLE_POLICY_VERSION=1
RELAYHALL_ENVIRONMENT=production

# IPv4-carrying IPv6 prefixes this DEPLOYMENT sits behind (card 837fe75b).
#
# The board refuses to open an outbound connection to an IPv6 address that
# carries an IPv4 destination — the registered forms (IPv4-compatible,
# -mapped, -translated, 6to4, Teredo, NAT64's well-known and local-use
# prefixes, and an ISATAP interface identifier) are built in and need no
# configuration.
#
# What CANNOT be built in is a prefix your organisation chose: RFC 6052 §2.2
# lets a NAT64 translator use any Network-Specific Prefix at /32, /40, /48,
# /56, /64 or /96, and RFC 5969 6rd lets a service provider do the same.
# Addresses under such a prefix read as ordinary global unicast and reach an
# IPv4 destination through the translator, so if the board sits behind one,
# name it here and everything under it is refused.
#
# Comma-separated `<ipv6>/<bits>`, canonical (no bits set below the length).
# EMPTY BY DEFAULT: unset, or wholly blank, means no prefixes.
#
# Anything else is a LIST and every entry in it must name a prefix. A
# malformed value — including a stray comma, so `,` or a trailing `,` —
# stops the process rather than being ignored. A prefix silently dropped is
# a hole that looks like a closed one, and a setting that looks configured
# has to close what it names.
#
# RELAYHALL_IPV4_CARRIER_PREFIXES=2606:4700:1234:5600::/64

# The exact origin browsers use for the dashboard: scheme, host and port (a
# default port, 80 for http or 443 for https, is left out, as browsers leave it
# out). ./setup.sh writes it from the public address you give it.
CORS_ORIGIN=http://localhost:8082

# =====================================================
# PUBLIC ADDRESS (optional)
# =====================================================
# The URL of the API as browsers and agents reach it, ending in /api, for
# example https://board.example.com/api behind a TLS reverse proxy. It is the
# address every onboarding pack names (board endpoint, bootstrap line, MCP and
# CLI lines), and single sign-on needs it. Empty = derived from each request:
# the shipped nginx forwards the browser's scheme, host and port. ./setup.sh
# writes it when you answer https. See DEPLOYMENT.md, Domain and TLS.
RELAYHALL_PUBLIC_API_URL=

# How many proxies in front of the backend it trusts for the client address
# and scheme. 1, the default, is the frontend's own nginx. Behind one more
# reverse proxy, set 2, so per-client sign-in throttling sees the real client
# rather than the proxy.
# TRUST_PROXY_HOPS=1

# =====================================================
# FRONTEND BUILD
# =====================================================
# Keep this relative for same-origin API and WebSocket routing through nginx.
VITE_API_BASE_URL=/api

# =====================================================
# DATA & STORAGE
# =====================================================
# Data directory for persistent files
DATA_DIR=./data

# Optional: Custom backup directory
BACKUP_DIR=./backups

# =====================================================
# OPTIONAL: ADVANCED
# =====================================================
# Database backup retention (number of backups to keep)
KEEP_BACKUPS=7

# Optional read-only model catalog. Leave the key empty to use the static floor.
# LITELLM_ADMIN_API_URL=http://litellm:4000
# LITELLM_MASTER_KEY=


# Optional policy bounds on concurrently active task leases (docs/seams.md §4).
# Unset or empty = UNLIMITED (the default). Integers 1-64; the per-project bound
# may not exceed the global one when both are set. The claim/lease surface itself
# is always on - there is no switch. Verify what a running process actually got:
#   curl --fail http://localhost:8082/api/health/orchestration
#RELAYHALL_MAX_ACTIVE_GLOBAL=
#RELAYHALL_MAX_ACTIVE_PER_PROJECT=

# Stable UUID unique to this deployment; provision once and retain across restarts.
# Empty preserves legacy operations and refuses versioned coordination.
RELAYHALL_DEPLOYMENT_ID=
