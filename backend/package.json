{
  "name": "relayhall-backend",
  "version": "1.0.0-beta.1",
  "description": "Backend API for RelayHall",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec \"node ./node_modules/ts-node/dist/bin.js\" src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:blueprints": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/blueprintLiveContract.test.ts",
    "test:blueprints:setup": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/blueprintSetupLive.test.ts",
    "test:blueprints:descriptor": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/blueprintDescriptorLive.test.ts",
    "test:blueprints:authority": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/blueprintGateAuthorityLive.test.ts",
    "test:blueprints:examples": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/blueprintExamplesLive.test.ts",
    "test:personality-versions": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/personalityVersionLive.test.ts",
    "test:idempotency": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/idempotencyContract.test.ts",
    "test:list-parity": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/listPointParity.test.ts",
    "test:project-bounded": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/projectBoundedSelectorLive.test.ts",
    "test:project-task-inheritance": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/projectTaskGrantInheritanceLive.test.ts",
    "test:project-target": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/taskProjectTargetAuthorization.test.ts",
    "test:point-refusal": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/taskPointRefusalShape.test.ts",
    "test:touch-burst": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/sessionTouchBurst.test.ts",
    "test:mint-target": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/mintTargetAuthorization.test.ts",
  "test:report-link": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/reportLinkAuthorization.test.ts",
  "test:telemetry-projection": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/telemetryProjectionAuthorization.test.ts",
  "test:carriage": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/directoryCarriageLive.test.ts",
  "drill:lenses-a": "node ./node_modules/.bin/tsx scripts/lenses-a-mutation-drill.ts",
    "test:scale-load": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/scaleReadLoad.test.ts",
  "test:day-one-connection": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/dayOneConnectionAcceptance.test.ts",
  "test:password-act": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/accountPasswordAct.test.ts",
    "test:knowledge-board": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/kw1KnowledgeBoardAuthorization.test.ts",
    "test:task-write-fields": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/taskWriteFieldContract.test.ts",
  "test:lenses-home-group": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --runTestsByPath src/__tests__/lensesCreationDefaultLive.test.ts",
    "test:migrations:hardened": "node scripts/test-hardened-orchestration-migrations.js",
    "test:migrations:canonical-sessions": "node scripts/test-canonical-session-migration.js",
    "test:migrations:telemetry-envelope": "node ./node_modules/.bin/tsx scripts/test-telemetry-envelope-migration.ts",
    "test:migrations:telemetry-governance": "node ./node_modules/.bin/tsx scripts/test-telemetry-governance-migration.ts",
    "test:limits:telemetry-receiver": "node ./node_modules/.bin/tsx scripts/test-telemetry-receiver-limits.ts",
    "migrate": "node ./node_modules/ts-node/dist/bin.js src/db/migrate.ts"
  },
  "keywords": [
    "dashboard",
    "ai",
    "api"
  ],
  "author": "RelayHall Contributors",
  "license": "MIT",
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/server": "2.0.0",
    "bcrypt": "^5.1.1",
    "busboy": "^1.6.0",
    "chokidar": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "ws": "^8.19.0",
    "yaml": "^2.9.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.11",
    "typescript": "^5.3.3"
  }
}
