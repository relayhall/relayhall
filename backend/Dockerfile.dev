FROM node:22-bookworm-slim

# Install python3 and httpx for imagine.py image generation tool
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip file ffmpeg ca-certificates git \
    && pip3 install --break-system-packages httpx Pillow \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_LOGLEVEL=error

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --silent --no-fund --no-audit --loglevel=error

# Copy source code
COPY . .

# Expose port
EXPOSE 3001

# Development command (will be overridden by docker-compose)
CMD ["npm", "run", "dev"]
